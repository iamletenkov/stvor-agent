#!/usr/bin/env bash
# bisquite-conf — настройки расширений bisquite: один разбор, одна проверка,
# одна запись и одно правило применения для всех доменов /etc/bisquite/<домен>.
#
#   bisquite-conf list                              домены со схемой
#   bisquite-conf show <домен>                      ключи, значения, умолчания, откуда
#   bisquite-conf get  <домен> KEY                  значение или умолчание схемы
#   bisquite-conf set  [--apply|--no-apply] <домен> KEY=VALUE…
#                                                   проверка, запись, применение
#
# KEY=- читает значение со stdin: секрет не попадает в argv и /proc/<pid>/cmdline.
# `set` применяет правку хуком домена (/opt/bisquite/knobs/<домен>.apply), но
# не пока система загружается (systemctl is-system-running = starting или
# initializing): тогда службы прочтут файл при своём старте. --no-apply —
# только записать, --apply — применить и во время загрузки.
#
# Файл схемы и библиотека — docs/extensions.md, раздел про настройки.

# ---------------------------------------------------------------------------
# Library part. Sourced by install.sh, configure.sh and service scripts as
#     source "$SCRIPT_DIR/lib/bisquite-conf"
# and executed as the CLI through the /usr/local/sbin/bisquite-conf symlink.
#
# Nothing here calls `exit` or relies on the caller's `set -e`: every public
# function returns non-zero and prints the reason, so both `set -euo pipefail`
# install scripts and `set -uo pipefail` CLIs get the same loud refusal.
#
# All paths honour BISQUITE_CONF_ROOT (empty on a real machine), so the whole
# library runs under a scratch root without root privileges.
# ---------------------------------------------------------------------------

# Absolute path of this file as it was reached (not resolved): conf_init links
# /usr/local/sbin/bisquite-conf here, i.e. through the extension directory, like
# /usr/local/sbin/bisquite-desktop. Resolving the CLI link with `readlink -f`
# then always lands in the same lib/<sha256> as the extension that installed it.
_CONF_LIB_PATH="${BASH_SOURCE[0]}"
[[ "$_CONF_LIB_PATH" == /* ]] || _CONF_LIB_PATH="$PWD/$_CONF_LIB_PATH"

declare -ga _CONF_KEYS=() _CONF_PREFIXES=() _CONF_F=()
declare -gA _CONF_TYPE=() _CONF_DEFAULT=() _CONF_DESC=() _CONF_PTYPE=() _CONF_PDESC=()
declare -ga _CONF_REC_KEY=() _CONF_REC_VAL=() _CONF_REC_START=() _CONF_REC_END=()
declare -gA _CONF_VAL=() _CONF_SRC=()
declare -ga _CONF_PEND_KEYS=()
declare -gA _CONF_PEND=() _CONF_PEND_NOTE=()
declare -g _CONF_WHY="" _CONF_KT="" _CONF_KD="" _CONF_KDESC=""
declare -g _CONF_T_RO=0 _CONF_T_SECRET="" _CONF_T_BASE="" _CONF_T_OPT=0

_conf_err(){ >&2 printf 'bisquite-conf: %s\n' "$*"; }

_conf_root(){ printf '%s' "${BISQUITE_CONF_ROOT:-}"; }
_conf_dir(){ printf '%s/etc/bisquite/%s' "$(_conf_root)" "$1"; }
_conf_file(){ printf '%s/etc/bisquite/%s/config' "$(_conf_root)" "$1"; }
_conf_knobs(){ printf '%s/opt/bisquite/knobs' "$(_conf_root)"; }

_conf_domain_ok(){
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] && return 0
    _conf_err "домен '$1': ожидали [a-z0-9-] (каталог в /etc/bisquite)"
    return 1
}

# ---------------------------------------------------------------------------
# Types
#
#   TYPE   := [ro:] ( BASE | secret | secret:hook | secret:BASE ) [?]
#   BASE   := bool | int | port | host | path | str | enum:a,b | re:ERE | list:BASE
#
# ?:       the key accepts an empty value even with a real default (flags that
#          may be cleared). Without it only a key with an empty default does.
#          A trailing `?` is always this marker: an ERE ends in `$`, not `?`.
# ro:      `bisquite-conf set` refuses the key; the owner writes it through
#          conf_set --allow-ro (bisquite-teleport join, a secret hook).
# secret:  the value is masked in `show`; the file gets 0600.
# hook:    the value is never stored: it goes to <домен>.secret on stdin, and
#          the pairs the hook prints are stored instead.
# ---------------------------------------------------------------------------
_conf_type_parse(){
    local t="$1"
    _CONF_T_RO=0; _CONF_T_SECRET=""; _CONF_T_BASE=""; _CONF_T_OPT=0
    if [[ "$t" == ro:* ]]; then _CONF_T_RO=1; t="${t#ro:}"; fi
    if [[ "$t" == *\? ]]; then _CONF_T_OPT=1; t="${t%\?}"; fi
    case "$t" in
        secret) _CONF_T_SECRET=1; _CONF_T_BASE=secret ;;
        secret:hook) _CONF_T_SECRET=hook ;;
        secret:*) _CONF_T_SECRET=1; _CONF_T_BASE="${t#secret:}" ;;
        *) _CONF_T_BASE="$t" ;;
    esac
    [[ "$_CONF_T_SECRET" == hook ]] && return 0
    _conf_base_ok "$_CONF_T_BASE"
}

_conf_base_ok(){
    local t="$1" re
    case "$t" in
        bool|int|port|host|path|str|secret) return 0 ;;
        enum:?*) return 0 ;;
        re:?*)
            re="${t#re:}"
            # An invalid ERE makes [[ =~ ]] return 2; catch it at schema load.
            local r=0
            # shellcheck disable=SC2319  # the status of [[ =~ ]] is the point
            [[ "" =~ $re ]] || r=$?
            (( r != 2 ))
            return ;;
        list:?*) [[ "${t#list:}" != list:* ]] && _conf_base_ok "${t#list:}"; return ;;
    esac
    return 1
}

# Check VALUE against BASE; on failure _CONF_WHY says what was expected.
_conf_base_check(){
    local t="$1" v="$2" item re
    local -a items
    _CONF_WHY=""
    case "$t" in
        secret)
            [[ "$v" != *$'\n'* && "$v" != *$'\r'* ]] || { _CONF_WHY="перевод строки в значении"; return 1; } ;;
        list:*)
            [[ -z "$v" ]] && return 0
            # `read` below sees the first line only: check the whole value first.
            if [[ "$v" == *[[:cntrl:]]* || "$v" == *'$'* || "$v" == *'`'* ]]; then
                # shellcheck disable=SC2016  # literal characters, not expansions
                _CONF_WHY='управляющие символы, `$` и обратные кавычки недопустимы'; return 1
            fi
            [[ "$v" != ,* && "$v" != *, && "$v" != *,,* ]] || { _CONF_WHY="пустой элемент списка"; return 1; }
            IFS=, read -r -a items <<< "$v"
            for item in "${items[@]}"; do
                _conf_base_check "${t#list:}" "$item" || { _CONF_WHY="элемент '$item': $_CONF_WHY"; return 1; }
            done ;;
        *)
            # Everything but a secret is a plain one-line value: no control
            # characters at all (CR is a line break for systemd), no `$` and no
            # backquote — the file is never executed, but values end up in
            # generated YAML, unit arguments and log lines.
            if [[ "$v" == *[[:cntrl:]]* || "$v" == *'$'* || "$v" == *'`'* ]]; then
                # shellcheck disable=SC2016  # literal characters, not expansions
                _CONF_WHY='управляющие символы, `$` и обратные кавычки недопустимы'; return 1
            fi
            case "$t" in
                bool) [[ "$v" == 0 || "$v" == 1 ]] || { _CONF_WHY="только 0 или 1"; return 1; } ;;
                int) [[ "$v" =~ ^-?[0-9]{1,18}$ ]] || { _CONF_WHY="ожидали целое число"; return 1; } ;;
                port)
                    if [[ ! "$v" =~ ^[0-9]{1,5}$ ]] || (( 10#$v < 1 || 10#$v > 65535 )); then
                        _CONF_WHY="ожидали порт 1–65535"; return 1
                    fi ;;
                host)
                    [[ "$v" =~ ^[A-Za-z0-9.:_][A-Za-z0-9.:_-]{0,253}$ ]] \
                        || { _CONF_WHY="ожидали имя хоста или IP-адрес"; return 1; } ;;
                path) [[ "$v" == /* ]] || { _CONF_WHY="ожидали абсолютный путь"; return 1; } ;;
                str) : ;;
                enum:*)
                    local IFS=,
                    for item in ${t#enum:}; do [[ "$v" == "$item" ]] && return 0; done
                    _CONF_WHY="допустимо: ${t#enum:}"; return 1 ;;
                re:*)
                    re="${t#re:}"
                    [[ "$v" =~ $re ]] || { _CONF_WHY="не подходит под шаблон $re"; return 1; } ;;
                *) _CONF_WHY="неизвестный тип '$t'"; return 1 ;;
            esac ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Schema file
#
#   # ключ   тип                  умолчание   описание
#   X_PORT   port                 5900        порт
#   X_ADDR   "re:^[a-z ]+$"       —           поле в кавычках может содержать пробелы
#   X_*      str                  —           шаблон: любой ключ с префиксом X_
#
# `—` is the empty default. A key with an empty default (or a `?` type)
# accepts an empty value; any other key does not (X_PORT= would break the
# service).
# ---------------------------------------------------------------------------
_conf_ltrim(){ local s="$1"; printf '%s' "${s#"${s%%[![:space:]]*}"}"; }

_conf_split_fields(){
    local s="$1" f i
    _CONF_F=()
    for i in 1 2 3; do
        s="$(_conf_ltrim "$s")"
        [[ -n "$s" ]] || return 1
        if [[ "$s" == \"* ]]; then
            s="${s:1}"
            [[ "$s" == *\"* ]] || return 1
            f="${s%%\"*}"; s="${s#*\"}"
            [[ -z "$s" || "$s" == [[:space:]]* ]] || return 1
        else
            f="${s%%[[:space:]]*}"; s="${s:${#f}}"
        fi
        _CONF_F+=("$f")
    done
    _CONF_F+=("$(_conf_ltrim "$s")")
}

# _conf_schema_load <домен> [файл схемы]; without a file — the registered one.
_conf_schema_load(){
    local domain="$1" schema="${2:-}" line n=0 key type def desc rc=0
    _conf_domain_ok "$domain" || return 1
    [[ -n "$schema" ]] || schema="$(_conf_knobs)/$domain"
    if [[ ! -r "$schema" ]]; then
        _conf_err "$domain: нет схемы $schema — домен не установлен (bisquite-conf list)"
        return 1
    fi
    _CONF_KEYS=(); _CONF_PREFIXES=()
    _CONF_TYPE=(); _CONF_DEFAULT=(); _CONF_DESC=(); _CONF_PTYPE=(); _CONF_PDESC=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1))
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if ! _conf_split_fields "$line"; then
            _conf_err "$schema:$n: ожидали «ключ тип умолчание описание»"; rc=1; continue
        fi
        key="${_CONF_F[0]}"; type="${_CONF_F[1]}"; def="${_CONF_F[2]}"; desc="${_CONF_F[3]}"
        [[ "$def" == "—" ]] && def=""
        if ! _conf_type_parse "$type"; then
            _conf_err "$schema:$n: $key: неизвестный тип '$type'"; rc=1; continue
        fi
        if [[ "$key" =~ ^([A-Z][A-Z0-9_]*_)\*$ ]]; then
            key="${BASH_REMATCH[1]}"
            if [[ -n "${_CONF_PTYPE[$key]+x}" ]]; then
                _conf_err "$schema:$n: шаблон $key* объявлен дважды"; rc=1; continue
            fi
            if [[ -n "$def" || "$_CONF_T_SECRET" == hook ]]; then
                _conf_err "$schema:$n: $key*: у шаблона нет умолчания и хука"; rc=1; continue
            fi
            _CONF_PREFIXES+=("$key"); _CONF_PTYPE[$key]="$type"; _CONF_PDESC[$key]="$desc"
            continue
        fi
        if [[ ! "$key" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
            _conf_err "$schema:$n: ключ '$key': ожидали [A-Z0-9_]"; rc=1; continue
        fi
        if [[ -n "${_CONF_TYPE[$key]+x}" ]]; then
            _conf_err "$schema:$n: ключ $key объявлен дважды"; rc=1; continue
        fi
        if [[ -n "$def" ]]; then
            if [[ "$_CONF_T_SECRET" == hook ]]; then
                _conf_err "$schema:$n: $key: у secret:hook не бывает умолчания"; rc=1; continue
            fi
            if ! _conf_base_check "$_CONF_T_BASE" "$def"; then
                _conf_err "$schema:$n: $key: умолчание '$def' не проходит свой тип: $_CONF_WHY"; rc=1; continue
            fi
        fi
        _CONF_KEYS+=("$key"); _CONF_TYPE[$key]="$type"; _CONF_DEFAULT[$key]="$def"; _CONF_DESC[$key]="$desc"
    done < "$schema"
    (( rc == 0 )) || return 1
    if (( ${#_CONF_KEYS[@]} == 0 && ${#_CONF_PREFIXES[@]} == 0 )); then
        _conf_err "$schema: в схеме нет ни одного ключа"; return 1
    fi
    return 0
}

# Look KEY up in the loaded schema: _CONF_KT (type), _CONF_KD (default).
_conf_lookup(){
    local key="$1" p best=""
    if [[ -n "${_CONF_TYPE[$key]+x}" ]]; then
        _CONF_KT="${_CONF_TYPE[$key]}"; _CONF_KD="${_CONF_DEFAULT[$key]}"; _CONF_KDESC="${_CONF_DESC[$key]}"
        return 0
    fi
    for p in "${_CONF_PREFIXES[@]}"; do
        [[ "$key" == "$p"* && "$key" =~ ^[A-Z][A-Z0-9_]*$ && ${#p} -gt ${#best} ]] && best="$p"
    done
    [[ -n "$best" ]] || return 1
    _CONF_KT="${_CONF_PTYPE[$best]}"; _CONF_KD=""; _CONF_KDESC="${_CONF_PDESC[$best]}"
    return 0
}

_conf_keys_hint(){
    local s="${_CONF_KEYS[*]}" p
    for p in "${_CONF_PREFIXES[@]}"; do s+=" ${p}*"; done
    printf '%s' "$s"
}

# Validate one pair against the loaded schema. $3 = 1 allows ro keys.
_conf_check_pair(){
    local domain="$1" key="$2" val="$3" allow_ro="${4:-0}" shown
    if ! _conf_lookup "$key"; then
        _conf_err "$domain: неизвестный ключ '$key' (есть: $(_conf_keys_hint))"
        return 1
    fi
    _conf_type_parse "$_CONF_KT"
    if (( _CONF_T_RO && ! allow_ro )); then
        _conf_err "$domain: $key не меняется через set — ${_CONF_KDESC:-ключ только для чтения}"
        return 1
    fi
    if [[ -z "$val" ]]; then
        [[ -z "$_CONF_KD" ]] || (( _CONF_T_OPT )) && return 0
        _conf_err "$domain: $key: пустое значение недопустимо (умолчание $_CONF_KD)"
        return 1
    fi
    [[ "$_CONF_T_SECRET" == hook ]] && _CONF_T_BASE=secret
    if ! _conf_base_check "$_CONF_T_BASE" "$val"; then
        shown="'$val'"; [[ -n "$_CONF_T_SECRET" ]] && shown="(секрет)"
        _conf_err "$domain: $key=$shown: $_CONF_WHY${_CONF_KDESC:+ — $_CONF_KDESC}"
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Reading the file — the systemd EnvironmentFile grammar, not `source`.
#
# A state machine transcribed from parse_env_file_internal() in systemd's
# src/basic/env-file.c, so one file serves a unit's EnvironmentFile= and a
# script identically: quotes are stripped, `\` escapes, `\<newline>` joins
# lines, `#` and `;` start comments, the last assignment wins. Nothing in the
# file is ever expanded or executed.
#
# One known divergence between systemd versions: before v254 a comment line
# ending in `\` swallowed the next line; since v254 it does not (this parser
# follows v254+). Ubuntu 22.04 on Jetson ships 249. The writer never produces
# such a comment; do not write one by hand.
#
# Output: _CONF_REC_{KEY,VAL,START,END} — every assignment in file order with
# its 1-based line range, so the writer can replace it in place.
# ---------------------------------------------------------------------------
_conf_parse_file(){
    local file="$1"
    _CONF_REC_KEY=(); _CONF_REC_VAL=(); _CONF_REC_START=(); _CONF_REC_END=()
    [[ -f "$file" ]] || return 0
    if [[ ! -r "$file" ]]; then
        _conf_err "$file не читается — нужен root (sudo)"
        return 1
    fi
    # systemd's WHITESPACE is exactly " \t\n\r" — not [[:space:]] (\v, \f).
    local LC_ALL=C content c state=PK key="" val="" lkw=-1 lvw=-1 line=1 start=1 i n ws=$' \t\n\r' bs=$'\\'
    IFS= read -r -d '' content < "$file" || true
    n=${#content}
    for (( i = 0; i < n; i++ )); do
        c="${content:i:1}"
        case "$state" in
            PK)
                if [[ "$c" == '#' || "$c" == ';' ]]; then state=CM
                elif [[ "$ws" != *"$c"* ]]; then state=K; lkw=-1; key="$c"; start=$line
                fi ;;
            K)
                if [[ "$c" == $'\n' || "$c" == $'\r' ]]; then state=PK; key=""
                elif [[ "$c" == '=' ]]; then state=PV; lvw=-1; val=""
                else
                    if [[ "$ws" != *"$c"* ]]; then lkw=-1
                    elif (( lkw < 0 )); then lkw=${#key}
                    fi
                    key+="$c"
                fi ;;
            PV)
                if [[ "$c" == $'\n' || "$c" == $'\r' ]]; then
                    _conf_push "$key" "$lkw" "$val" "$start" "$line"; state=PK
                elif [[ "$c" == "'" ]]; then state=SQ
                elif [[ "$c" == '"' ]]; then state=DQ
                elif [[ "$c" == "$bs" ]]; then state=VE
                elif [[ "$ws" != *"$c"* ]]; then state=V; val+="$c"
                fi ;;
            V)
                if [[ "$c" == $'\n' || "$c" == $'\r' ]]; then
                    (( lvw >= 0 )) && val="${val:0:lvw}"
                    _conf_push "$key" "$lkw" "$val" "$start" "$line"; state=PK
                elif [[ "$c" == "$bs" ]]; then state=VE; lvw=-1
                else
                    if [[ "$ws" != *"$c"* ]]; then lvw=-1
                    elif (( lvw < 0 )); then lvw=${#val}
                    fi
                    val+="$c"
                fi ;;
            VE)
                state=V
                [[ "$c" == $'\n' || "$c" == $'\r' ]] || val+="$c" ;;
            SQ)
                if [[ "$c" == "'" ]]; then state=PV; else val+="$c"; fi ;;
            DQ)
                if [[ "$c" == '"' ]]; then state=PV
                elif [[ "$c" == "$bs" ]]; then state=DE
                else val+="$c"
                fi ;;
            DE)
                state=DQ
                if [[ "$c" == '"' || "$c" == "$bs" || "$c" == '`' || "$c" == '$' ]]; then val+="$c"
                elif [[ "$c" != $'\n' ]]; then val+="\\$c"
                fi ;;
            CM)
                if [[ "$c" == "$bs" ]]; then state=CE
                elif [[ "$c" == $'\n' || "$c" == $'\r' ]]; then state=PK
                fi ;;
            CE)
                if [[ "$c" == $'\n' || "$c" == $'\r' ]]; then state=PK; else state=CM; fi ;;
        esac
        [[ "$c" == $'\n' ]] && line=$((line + 1))
    done
    case "$state" in
        V) (( lvw >= 0 )) && val="${val:0:lvw}"
           _conf_push "$key" "$lkw" "$val" "$start" "$line" ;;
        PV|VE|SQ|DQ|DE) _conf_push "$key" "$lkw" "$val" "$start" "$line" ;;
    esac
    return 0
}

_conf_push(){
    local key="$1" lkw="$2" val="$3" start="$4" end="$5"
    (( lkw >= 0 )) && key="${key:0:lkw}"
    # systemd drops names that are not valid environment names; so do we.
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 0
    _CONF_REC_KEY+=("$key"); _CONF_REC_VAL+=("$val")
    _CONF_REC_START+=("$start"); _CONF_REC_END+=("$end")
}

# Fill _CONF_VAL/_CONF_SRC from schema defaults and the parsed file.
_conf_values(){
    local domain="$1" k i
    _CONF_VAL=(); _CONF_SRC=()
    for k in "${_CONF_KEYS[@]}"; do _CONF_VAL[$k]="${_CONF_DEFAULT[$k]}"; _CONF_SRC[$k]=умолчание; done
    _conf_parse_file "$(_conf_file "$domain")" || return 1
    for i in "${!_CONF_REC_KEY[@]}"; do
        k="${_CONF_REC_KEY[i]}"
        _conf_lookup "$k" || continue
        _CONF_VAL[$k]="${_CONF_REC_VAL[i]}"; _CONF_SRC[$k]=файл
    done
    return 0
}

# ---------------------------------------------------------------------------
# Writing
# ---------------------------------------------------------------------------

# Quote a value the way EnvironmentFile reads it back byte for byte.
_conf_quote(){
    local v="$1"
    if [[ "$v" =~ ^[A-Za-z0-9_./:,@%+=-]*$ ]]; then
        printf '%s' "$v"
    else
        v="${v//\\/\\\\}"; v="${v//\"/\\\"}"
        printf '"%s"' "$v"
    fi
}

_conf_stored_secrets(){
    local k
    for k in "${_CONF_KEYS[@]}"; do
        _conf_type_parse "${_CONF_TYPE[$k]}"
        [[ "$_CONF_T_SECRET" == 1 ]] && return 0
    done
    for k in "${_CONF_PREFIXES[@]}"; do
        _conf_type_parse "${_CONF_PTYPE[$k]}"
        [[ "$_CONF_T_SECRET" == 1 ]] && return 0
    done
    return 1
}

# Write _CONF_PEND into the domain file: every pending key replaces its first
# assignment in place (later duplicates are dropped — systemd would take the
# last one), new keys are appended. Comments, blank lines and the order of
# everything else stay. Atomic: temporary file in the same directory + mv.
_conf_write(){
    local domain="$1" dir file tmp mode=644 cur i j k s e fd="" rc=0
    dir="$(_conf_dir "$domain")"; file="$dir/config"
    if ! mkdir -p "$dir" || ! chmod 0755 "$dir"; then _conf_err "$domain: не создать $dir"; return 1; fi
    if command -v flock >/dev/null 2>&1 && exec {fd}<"$dir"; then
        flock -w 30 "$fd" || { _conf_err "$domain: $dir занят другой записью"; exec {fd}<&-; return 1; }
    fi
    local -a lines=() out=()
    local -A replace=() drop=() seen=()
    if [[ -f "$file" ]]; then
        mapfile -t lines < "$file"
        _conf_parse_file "$file" || rc=1
    else
        _CONF_REC_KEY=()
    fi
    if (( rc == 0 )); then
        for i in "${!_CONF_REC_KEY[@]}"; do
            k="${_CONF_REC_KEY[i]}"
            [[ -n "${_CONF_PEND[$k]+x}" ]] || continue
            s="${_CONF_REC_START[i]}"; e="${_CONF_REC_END[i]}"
            if [[ -z "${seen[$k]:-}" ]]; then
                seen[$k]=1; replace[$s]="$k"; s=$((s + 1))
            fi
            for (( j = s; j <= e; j++ )); do drop[$j]=1; done
        done
        for (( j = 1; j <= ${#lines[@]}; j++ )); do
            if [[ -n "${replace[$j]:-}" ]]; then
                k="${replace[$j]}"; out+=("$k=$(_conf_quote "${_CONF_PEND[$k]}")")
            elif [[ -z "${drop[$j]:-}" ]]; then
                out+=("${lines[j-1]}")
            fi
        done
        for k in "${_CONF_PEND_KEYS[@]}"; do
            [[ -n "${seen[$k]:-}" ]] && continue
            [[ -n "${_CONF_PEND_NOTE[$k]:-}" ]] && out+=("# ${_CONF_PEND_NOTE[$k]}")
            out+=("$k=$(_conf_quote "${_CONF_PEND[$k]}")")
        done
        # Never loosen: a file an operator closed to 0600 stays 0600.
        if _conf_stored_secrets; then
            mode=600
        else
            # Octal digits before the arithmetic: (( )) evaluates a[$(cmd)].
            cur="$(stat -c %a "$file" 2>/dev/null)" || cur=""
            [[ "$cur" =~ ^[0-7]{3,4}$ ]] && (( (8#$cur & 8#077) == 0 )) && mode=600
        fi
        if tmp="$(mktemp "$dir/.config.XXXXXX")"; then
            if chmod "$mode" "$tmp" && printf '%s\n' "${out[@]}" > "$tmp" && mv -f "$tmp" "$file"; then
                :
            else
                rm -f "$tmp"; _conf_err "$domain: запись $file не удалась"; rc=1
            fi
        else
            _conf_err "$domain: не создать временный файл в $dir"; rc=1
        fi
    fi
    [[ -n "$fd" ]] && exec {fd}<&-
    return "$rc"
}

_conf_pend_reset(){ _CONF_PEND_KEYS=(); _CONF_PEND=(); _CONF_PEND_NOTE=(); }
_conf_pend_add(){
    [[ -n "${_CONF_PEND[$1]+x}" ]] || _CONF_PEND_KEYS+=("$1")
    _CONF_PEND[$1]="$2"
}

# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

# conf_load <домен> — every schema key (and every key of an open template found
# in the file) becomes a shell variable of the same name: file value or schema
# default. Values are not validated here; conf_check does that.
conf_load(){
    local domain="${1:-}" k
    _conf_schema_load "$domain" || return 1
    _conf_values "$domain" || return 1
    for k in "${!_CONF_VAL[@]}"; do printf -v "$k" '%s' "${_CONF_VAL[$k]}"; done
    return 0
}

# conf_get <домен> KEY — print the value or the schema default.
conf_get(){
    local domain="${1:-}" key="${2:-}"
    _conf_schema_load "$domain" || return 1
    if ! _conf_lookup "$key"; then
        _conf_err "$domain: неизвестный ключ '$key' (есть: $(_conf_keys_hint))"; return 1
    fi
    _conf_values "$domain" || return 1
    printf '%s\n' "${_CONF_VAL[$key]-}"
}

# conf_keys <домен> — explicit schema keys, one per line, in schema order.
conf_keys(){
    _conf_schema_load "${1:-}" || return 1
    printf '%s\n' "${_CONF_KEYS[@]}"
}

# conf_check <домен> — validate what the file holds now (hand edits, sed).
conf_check(){
    local domain="${1:-}" k rc=0
    _conf_schema_load "$domain" || return 1
    _conf_values "$domain" || return 1
    for k in "${!_CONF_VAL[@]}"; do
        [[ "${_CONF_SRC[$k]}" == файл ]] || continue
        _conf_check_pair "$domain" "$k" "${_CONF_VAL[$k]}" 1 || rc=1
    done
    return "$rc"
}

# conf_validate <домен> [--allow-ro] KEY=VALUE… — check without writing.
conf_validate(){
    local domain="${1:-}" allow_ro=0 pair rc=0
    shift || true
    [[ "${1:-}" == --allow-ro ]] && { allow_ro=1; shift; }
    _conf_schema_load "$domain" || return 1
    for pair in "$@"; do
        if [[ "$pair" != *=* ]]; then _conf_err "$domain: ожидали KEY=VALUE, получили '$pair'"; rc=1; continue; fi
        _conf_check_pair "$domain" "${pair%%=*}" "${pair#*=}" "$allow_ro" || rc=1
    done
    return "$rc"
}

# conf_set <домен> [--allow-ro] KEY=VALUE… — validate all, run secret hooks,
# write atomically. Nothing is written unless every pair and every hook passed.
# KEY=- reads the value from stdin (once per call).
conf_set(){
    local domain="${1:-}" allow_ro=0 pair key val stdin_used=0 hook out line rc=0
    shift || true
    [[ "${1:-}" == --allow-ro ]] && { allow_ro=1; shift; }
    _conf_schema_load "$domain" || return 1
    if (( $# == 0 )); then _conf_err "$domain: нужен хотя бы один KEY=VALUE"; return 1; fi
    _conf_pend_reset
    local -a hook_keys=()
    local -A given=() hookval=()
    for pair in "$@"; do
        if [[ "$pair" != *=* ]]; then _conf_err "$domain: ожидали KEY=VALUE, получили '$pair'"; rc=1; continue; fi
        key="${pair%%=*}"; val="${pair#*=}"
        if [[ -n "${given[$key]:-}" ]]; then _conf_err "$domain: $key задан дважды"; rc=1; continue; fi
        given[$key]=1
        if [[ "$val" == - ]]; then
            if (( stdin_used )); then _conf_err "$domain: со stdin читается только одно значение"; rc=1; continue; fi
            stdin_used=1
            # Empty stdin is a refusal, not an empty value: for a secret:hook key
            # empty means "remove the password", and `echo "$UNSET" | …` or a
            # closed pipe must never open a VNC server. Clear with `KEY=`.
            val=""
            if ! IFS= read -r val && [[ -z "$val" ]]; then
                _conf_err "$domain: $key=-: stdin пуст — значение не прочитано (очистить ключ: $key=)"; rc=1; continue
            fi
            if [[ -z "$val" ]]; then
                _conf_err "$domain: $key=-: со stdin пришла пустая строка (очистить ключ: $key=)"; rc=1; continue
            fi
        fi
        _conf_check_pair "$domain" "$key" "$val" "$allow_ro" || { rc=1; continue; }
        _conf_type_parse "$_CONF_KT"
        if [[ "$_CONF_T_SECRET" == hook ]]; then
            hook_keys+=("$key"); hookval[$key]="$val"
        else
            _conf_pend_add "$key" "$val"
        fi
    done
    (( rc == 0 )) || return 1
    for key in "${hook_keys[@]}"; do
        hook="$(_conf_knobs)/$domain.secret"
        if [[ ! -x "$hook" ]]; then
            _conf_err "$domain: $key — secret:hook, а хука $hook нет; ничего не записано"; return 1
        fi
        if ! out="$(printf '%s' "${hookval[$key]}" | "$hook" "$key")"; then
            _conf_err "$domain: хук $hook отказал для $key; ничего не записано"; return 1
        fi
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            if [[ "$line" != *=* ]]; then
                _conf_err "$domain: хук $key напечатал не KEY=VALUE: '$line'; ничего не записано"; return 1
            fi
            if [[ -n "${given[${line%%=*}]:-}" ]]; then
                _conf_err "$domain: ${line%%=*} задан и явно, и хуком $key; ничего не записано"; return 1
            fi
            _conf_check_pair "$domain" "${line%%=*}" "${line#*=}" 1 || { _conf_err "$domain: ничего не записано"; return 1; }
            _conf_type_parse "$_CONF_KT"
            if [[ "$_CONF_T_SECRET" == hook ]]; then
                _conf_err "$domain: хук $key вернул secret:hook ключ ${line%%=*}; ничего не записано"; return 1
            fi
            _conf_pend_add "${line%%=*}" "${line#*=}"
        done <<< "$out"
    done
    (( ${#_CONF_PEND_KEYS[@]} )) || return 0
    _conf_write "$domain"
}

# conf_init <домен> <схема> [--env] [--migrate-yaml YAML=KEY,…] [KEY=VALUE…]
#
# For install.sh. Registers the schema and its hooks, creates the file, adds
# keys that are missing with their defaults and never touches keys already
# there — a reinstall keeps the operator's edits. Explicit VMFILE parameters
# are a decision of the layer author and go on top through conf_set:
# --env takes every exported schema key (and template key) from the
# environment; pairs after the options are taken as given.
conf_init(){
    local domain="${1:-}" schema="${2:-}" use_env=0 yaml_map="" knobs hook k p rc=0
    shift 2 || { _conf_err "conf_init: нужны домен и путь схемы"; return 1; }
    while (( $# )); do
        case "$1" in
            --env) use_env=1; shift ;;
            --migrate-yaml) yaml_map="${2:-}"; shift 2 || { _conf_err "conf_init: --migrate-yaml без значения"; return 1; } ;;
            *) break ;;
        esac
    done
    _conf_domain_ok "$domain" || return 1
    if [[ "$schema" != /* ]]; then
        _conf_err "$domain: путь схемы должен быть абсолютным: '$schema' (он уходит в ссылку)"; return 1
    fi
    _conf_schema_load "$domain" "$schema" || return 1

    # Registration: the last installer wins, as with /usr/local/sbin/bisquite-desktop —
    # in a FROM chain the child layer carries the newer schema. A hook the new
    # owner does not have is removed, not left pointing at the old one.
    knobs="$(_conf_knobs)"
    mkdir -p "$knobs" || { _conf_err "$domain: не создать $knobs"; return 1; }
    ln -sfn "$schema" "$knobs/$domain" || return 1
    for hook in apply secret; do
        if [[ -f "$schema.$hook" ]]; then
            [[ -x "$schema.$hook" ]] || chmod +x "$schema.$hook" || return 1
            ln -sfn "$schema.$hook" "$knobs/$domain.$hook" || return 1
        else
            rm -f "$knobs/$domain.$hook"
        fi
    done
    if [[ "$(basename "$_CONF_LIB_PATH")" == bisquite-conf ]]; then
        mkdir -p "$(_conf_root)/usr/local/sbin" \
            && ln -sfn "$_CONF_LIB_PATH" "$(_conf_root)/usr/local/sbin/bisquite-conf" || return 1
    fi

    # Missing keys with a real default. Keys with an empty default are not
    # written: for a template-driven service (Selkies) an empty variable is not
    # the same as an absent one.
    if [[ ! -f "$(_conf_file "$domain")" ]]; then
        _conf_new_file "$domain" || { _conf_err "$domain: не создать $(_conf_file "$domain")"; return 1; }
    fi
    _conf_parse_file "$(_conf_file "$domain")" || return 1
    local -A present=()
    for k in "${_CONF_REC_KEY[@]}"; do present[$k]=1; done
    _conf_pend_reset
    for k in "${_CONF_KEYS[@]}"; do
        [[ -n "${present[$k]:-}" || -z "${_CONF_DEFAULT[$k]}" ]] && continue
        _conf_pend_add "$k" "${_CONF_DEFAULT[$k]}"
        _CONF_PEND_NOTE[$k]="${_CONF_DESC[$k]}"
    done
    if (( ${#_CONF_PEND_KEYS[@]} )); then
        _conf_write "$domain" || return 1
    fi

    if [[ -n "$yaml_map" ]]; then
        _conf_migrate_yaml "$domain" "$yaml_map" || return 1
    fi

    local -a pairs=()
    if (( use_env )); then
        local -a exported=()
        mapfile -t exported < <(compgen -e)
        for k in "${exported[@]}"; do
            _conf_lookup "$k" || continue
            _conf_type_parse "$_CONF_KT"
            if (( _CONF_T_RO )); then
                _conf_err "$domain: параметр $k из окружения пропущен — ${_CONF_KDESC:-ключ только для чтения}"
                continue
            fi
            pairs+=("$k=${!k}")
        done
    fi
    for p in "$@"; do pairs+=("$p"); done
    if (( ${#pairs[@]} )); then
        conf_set "$domain" "${pairs[@]}" < /dev/null || rc=1
    fi
    return "$rc"
}

_conf_new_file(){
    local domain="$1" dir file tmp
    dir="$(_conf_dir "$domain")"; file="$dir/config"
    mkdir -p "$dir" && chmod 0755 "$dir" || return 1
    tmp="$(mktemp "$dir/.config.XXXXXX")" || return 1
    chmod 644 "$tmp"
    if _conf_stored_secrets; then chmod 600 "$tmp"; fi
    {
        printf '# Настройки домена %s. Схема — /opt/bisquite/knobs/%s.\n' "$domain" "$domain"
        printf '# Менять командой: она проверяет значение и применяет правку.\n'
        printf '#   sudo bisquite-conf set %s KEY=VALUE\n' "$domain"
        printf '# Ключи, значения и умолчания: bisquite-conf show %s\n' "$domain"
    } > "$tmp" && mv -f "$tmp" "$file"
}

# One-shot migration of /etc/bisquite/<домен>/config.yaml (layout 2, before
# the knobs library). The file is ours and shallow: top-level scalars, one
# level of nesting (SECTION.KEY) and flow lists ['a', 'b'] (joined with
# commas). Mapped values go through conf_set; on success the YAML is removed,
# on refusal it stays and install.sh fails.
_conf_migrate_yaml(){
    local domain="$1" map="$2" yaml item line key val section="" listkey="" name k
    yaml="$(_conf_dir "$domain")/config.yaml"
    [[ -f "$yaml" ]] || return 0
    local -A to=() got=()
    local -a pairs=() items=() order=() unmapped=()
    IFS=, read -r -a items <<< "$map"
    for item in "${items[@]}"; do to[${item%%=*}]="${item#*=}"; done
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%$'\r'}"
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*):[[:space:]]*(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"; section="$key"
        elif [[ "$line" =~ ^[[:space:]]+([A-Za-z_][A-Za-z0-9_]*):[[:space:]]*(.*)$ ]]; then
            key="$section.${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
        elif [[ -n "$listkey" && "$line" =~ ^[[:space:]]*-[[:space:]]+(.*)$ ]]; then
            # A block sequence item of the last key that had no inline value.
            val="$(_conf_yaml_scalar "${BASH_REMATCH[1]}")"
            [[ -n "$val" ]] && got[$listkey]+="${got[$listkey]:+,}$val"
            continue
        else
            _conf_err "$domain: $yaml: строка не разобрана — «$line»; файл не перенесён"
            return 1
        fi
        val="$(_conf_yaml_scalar "$val")"
        [[ -n "${got[$key]+x}" ]] || order+=("$key")
        got[$key]="$val"
        listkey=""
        [[ -z "$val" ]] && listkey="$key"
    done < "$yaml"
    for k in "${order[@]}"; do
        [[ -n "${got[$k]}" ]] || continue
        name="${to[$k]:-}"
        if [[ -z "$name" ]]; then
            unmapped+=("$k"); continue
        fi
        pairs+=("$name=${got[$k]}")
    done
    if (( ${#pairs[@]} )); then
        if ! conf_set "$domain" "${pairs[@]}" < /dev/null; then
            _conf_err "$domain: $yaml не перенесён — исправьте значения и повторите установку"
            return 1
        fi
    fi
    if (( ${#unmapped[@]} )); then
        # Keys that are not knobs of the domain (section headers aside) — say
        # which values stay behind rather than drop them silently.
        _conf_err "$domain: из $yaml не переносятся (не ручки домена): ${unmapped[*]}"
    fi
    rm -f "$yaml"
    >&2 printf 'bisquite-conf: %s: %s перенесён в %s (%d знач.) и удалён\n' \
        "$domain" "$yaml" "$(_conf_file "$domain")" "${#pairs[@]}"
    return 0
}

_conf_yaml_scalar(){
    local v="$1" out="" item
    local -a items=()
    v="$(_conf_ltrim "$v")"
    if [[ "$v" == \[* ]]; then
        v="${v#\[}"; v="${v%%\]*}"
        IFS=, read -r -a items <<< "$v"
        for item in "${items[@]}"; do
            item="$(_conf_yaml_scalar "$item")"
            [[ -n "$item" ]] && out+="${out:+,}$item"
        done
        printf '%s' "$out"; return
    fi
    if [[ "$v" == \'* ]]; then
        v="${v:1}"; v="${v//\'\'/$'\x01'}"; v="${v%%\'*}"; printf '%s' "${v//$'\x01'/\'}"; return
    fi
    if [[ "$v" == \"* ]]; then
        v="${v:1}"; printf '%s' "${v%%\"*}"; return
    fi
    [[ "$v" == \#* ]] && v=""
    v="${v%%[[:space:]]#*}"
    v="${v%"${v##*[![:space:]]}"}"
    [[ "$v" == "~" || "$v" == null ]] && v=""
    printf '%s' "$v"
}

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
_conf_usage(){ sed -n '2,16p' "$_CONF_LIB_PATH" | sed 's/^# \{0,1\}//'; }

_conf_need_root(){
    [[ -n "${BISQUITE_CONF_ROOT:-}" || "$(id -u)" -eq 0 ]] && return 0
    _conf_err "нужен root (sudo)"; return 1
}

# conf_cli_set [--apply|--no-apply] <домен> KEY=VALUE… — `bisquite-conf set`;
# bisquite-desktop and bisquite-teleport call it for their own `set`.
conf_cli_set(){
    local mode=auto domain="" state hook rc
    local -a pairs=()
    while (( $# )); do
        case "$1" in
            --apply) mode=apply ;;
            --no-apply) mode=none ;;
            -*) _conf_err "set: неизвестный флаг '$1'"; return 2 ;;
            *) if [[ -z "$domain" ]]; then domain="$1"; else pairs+=("$1"); fi ;;
        esac
        shift
    done
    [[ -n "$domain" ]] || { _conf_err "set: нужен домен (bisquite-conf list)"; return 2; }
    _conf_need_root || return 1
    conf_set "$domain" "${pairs[@]}" || return 1
    local -a keys=()
    local p
    for p in "${pairs[@]}"; do keys+=("${p%%=*}"); done
    _conf_err "$domain: записано в $(_conf_file "$domain") (${keys[*]})"

    hook="$(_conf_knobs)/$domain.apply"
    if [[ "$mode" == none ]]; then
        _conf_err "$domain: --no-apply — применится при старте служб"; return 0
    fi
    if [[ ! -x "$hook" ]]; then
        _conf_err "$domain: у домена нет хука применения — службы прочтут файл при старте"; return 0
    fi
    if [[ "$mode" == auto ]]; then
        state="$(systemctl is-system-running 2>/dev/null)" || true
        case "$state" in
            running|degraded|maintenance) ;;
            starting|initializing)
                _conf_err "$domain: система загружается ($state) — применится при старте служб (--apply — применить сейчас)"
                return 0 ;;
            *)
                _conf_err "$domain: systemd не запущен (${state:-нет systemctl}) — применится при старте служб"
                return 0 ;;
        esac
    fi
    "$hook" "${keys[@]}"; rc=$?
    if (( rc != 0 )); then
        _conf_err "$domain: записано, но хук $hook отказал (код $rc)"
        return 1
    fi
    return 0
}

# printf pads by bytes; pad by characters so Cyrillic columns line up.
_conf_row(){
    local out="" f w pad
    while (( $# > 1 )); do
        f="$1"; w="$2"; shift 2
        pad=$(( w - ${#f} )); (( pad < 1 )) && pad=1
        printf -v pad '%*s' "$pad" ''
        out+="$f$pad"
    done
    printf '%s%s\n' "$out" "${1:-}"
}

_conf_cli_show(){
    local domain="${1:-}" k v src t owner bad
    [[ -n "$domain" ]] || { _conf_err "show: нужен домен (bisquite-conf list)"; return 2; }
    _conf_schema_load "$domain" || return 1
    _conf_values "$domain" || return 1
    owner="$(readlink "$(_conf_knobs)/$domain" 2>/dev/null || true)"
    printf 'домен %s: %s\nсхема: %s\n\n' "$domain" "$(_conf_file "$domain")" "${owner:-$(_conf_knobs)/$domain}"
    _conf_row КЛЮЧ 36 ЗНАЧЕНИЕ 26 ОТКУДА 11 'ТИП — ОПИСАНИЕ'
    local -a order=("${_CONF_KEYS[@]}")
    for k in $(printf '%s\n' "${!_CONF_VAL[@]}" | sort); do
        [[ -n "${_CONF_TYPE[$k]+x}" ]] || order+=("$k")
    done
    for k in "${order[@]}"; do
        _conf_lookup "$k"; t="$_CONF_KT"; _conf_type_parse "$t"
        v="${_CONF_VAL[$k]-}"; src="${_CONF_SRC[$k]:-}"
        bad=""
        if [[ "$src" == файл ]] && ! _conf_check_pair "$domain" "$k" "$v" 1 2>/dev/null; then bad=" [НЕВЕРНО]"; fi
        if [[ "$_CONF_T_SECRET" == hook ]]; then v="<хук>"; src="—"
        elif [[ -n "$_CONF_T_SECRET" ]]; then [[ -n "$v" ]] && v="<задан>"
        fi
        [[ -n "$v" ]] || v="—"
        _conf_row "$k" 36 "$v" 26 "$src" 11 "$t${_CONF_KDESC:+ — $_CONF_KDESC}$bad"
    done
    for k in "${_CONF_PREFIXES[@]}"; do
        _conf_row "${k}*" 36 "" 26 шаблон 11 "${_CONF_PTYPE[$k]}${_CONF_PDESC[$k]:+ — ${_CONF_PDESC[$k]}}"
    done
}

_conf_cli_list(){
    local f d
    shopt -s nullglob
    for f in "$(_conf_knobs)"/*; do
        d="$(basename "$f")"
        [[ "$d" == *.* ]] && continue
        printf '%-20s %s%s%s\n' "$d" "$(readlink "$f")" \
            "$([[ -x "$f.apply" ]] && echo ' +apply')" "$([[ -x "$f.secret" ]] && echo ' +secret')"
    done
    shopt -u nullglob
}

conf_main(){
    local cmd="${1:-}"
    shift || true
    case "$cmd" in
        list) _conf_cli_list ;;
        show) _conf_cli_show "$@" ;;
        get)
            (( $# == 2 )) || { _conf_err "get: нужно <домен> KEY"; return 2; }
            conf_get "$1" "$2" ;;
        set) conf_cli_set "$@" ;;
        -h|--help|help) _conf_usage ;;
        *) _conf_usage >&2; return 2 ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -uo pipefail
    conf_main "$@"
    exit $?
fi
