{
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": []
    },
    "knowledge-graph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-knowledge-graph", "--memory-path", ".aim"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
