#!/bin/sh /etc/rc.common
# shellcheck shell=sh disable=SC2034,SC3043 # rc.common reads START/STOP; busybox ash has local
# stvor-agent: keeps the Teleport labels of this OpenWrt robot equal to the
# portal (spec OpenWrt §4.3) — the procd counterpart of stvor-agent.service.
# Runs as root: its children (cream, the teleport-openwrt extension) write /etc
# and restart /etc/init.d/teleport. procd has no sandbox but no_new_privs
# (SECURITY.md). Started only when the token exists, as
# ConditionPathExists= of the unit; `stvor-agent enable` writes it and runs
# `enable` and `restart` here.
#
# Paths: /var is tmpfs on OpenWrt, so the state is /opt/stvor-agent (state.json,
# machine-id; 0750 root:stvor-telemetry — the telemetry service reads the
# machine-id). The lock /run/stvor-agent.lock: /run is the link to /var/run
# (tmpfs) that /etc/init.d/boot (START=10) makes at every boot.

USE_PROCD=1
START=99
STOP=01

PROG=/usr/bin/stvor-agent
TOKEN=/etc/stvor-agent/token
STATE_DIR=/opt/stvor-agent
CONFIG=/etc/cream/stvor-agent-openwrt/config
TELEMETRY_USER=stvor-telemetry

# The user and group of the telemetry service (sysusers.d on Debian): a
# system user without a login, made with the helpers of /lib/functions.sh.
ensure_telemetry_user() {
	local gid
	group_exists "$TELEMETRY_USER" && user_exists "$TELEMETRY_USER" && return 0
	gid=$(group_add_next "$TELEMETRY_USER") || return 1
	user_exists "$TELEMETRY_USER" ||
		user_add "$TELEMETRY_USER" "" "$gid" "Stvor agent telemetry" /var/run/stvor-agent-telemetry /bin/false
}

# After ensure_telemetry_user: the group exists.
prepare_state_dir() {
	mkdir -p "$STATE_DIR" && chown "root:$TELEMETRY_USER" "$STATE_DIR" && chmod 0750 "$STATE_DIR"
}

# KEY=VALUE of the two settings the service reads; the file is never sourced.
agent_env() {
	[ -f "$CONFIG" ] || return 0
	sed -n -E 's/^(STVOR_AGENT_(INTERVAL|LOG_LEVEL))=([A-Za-z0-9_.:-]+)$/\1=\3/p' "$CONFIG"
}

start_service() {
	[ -f "$TOKEN" ] || return 0
	ensure_telemetry_user || return 1
	prepare_state_dir || return 1

	procd_open_instance
	procd_set_param command "$PROG" run
	# shellcheck disable=SC2046 # KEY=VALUE words without spaces (agent_env)
	procd_set_param env $(agent_env)
	procd_set_param respawn 3600 10 0
	procd_set_param term_timeout 120
	procd_set_param no_new_privs 1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
