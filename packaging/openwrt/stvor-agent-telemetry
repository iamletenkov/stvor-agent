#!/bin/sh /etc/rc.common
# shellcheck shell=sh disable=SC2034,SC3043 # rc.common reads START/STOP; busybox ash has local
# stvor-agent-telemetry: telemetry of this OpenWrt robot to the portal — the
# procd counterpart of stvor-agent-telemetry.service. Unprivileged: user and
# group stvor-telemetry, no_new_privs; procd has no other sandbox and no
# cgroup caps (SECURITY.md), GOMEMLIMIT keeps the Go heap small. Started only
# when the telemetry token exists; stvor-agent (root) writes it and runs
# `enable` and `restart` here.
#
# Writes: /opt/stvor-agent/telemetry (buffer, markers; /var is tmpfs on
# OpenWrt) and /run/stvor-agent-telemetry (status, tmpfs).

USE_PROCD=1
START=99
STOP=01

PROG=/usr/bin/stvor-agent
TOKEN=/etc/stvor-agent-telemetry/token
STATE_DIR=/opt/stvor-agent
CONFIG=/etc/cream/stvor-agent-openwrt/config
TELEMETRY_USER=stvor-telemetry

ensure_telemetry_user() {
	local gid
	group_exists "$TELEMETRY_USER" && user_exists "$TELEMETRY_USER" && return 0
	gid=$(group_add_next "$TELEMETRY_USER") || return 1
	user_exists "$TELEMETRY_USER" ||
		user_add "$TELEMETRY_USER" "" "$gid" "Stvor agent telemetry" /var/run/stvor-agent-telemetry /bin/false
}

# own_dir <dir> <mode>: the directory of the service, owned by its user.
own_dir() {
	mkdir -p "$1" && chown "$TELEMETRY_USER:$TELEMETRY_USER" "$1" && chmod "$2" "$1"
}

agent_env() {
	[ -f "$CONFIG" ] || return 0
	sed -n -E 's/^(STVOR_AGENT_(INTERVAL|LOG_LEVEL))=([A-Za-z0-9_.:-]+)$/\1=\3/p' "$CONFIG"
}

start_service() {
	[ -f "$TOKEN" ] || return 0
	ensure_telemetry_user || return 1
	mkdir -p "$STATE_DIR" && chown "root:$TELEMETRY_USER" "$STATE_DIR" && chmod 0750 "$STATE_DIR" || return 1
	own_dir "$STATE_DIR/telemetry" 0700 || return 1
	own_dir /run/stvor-agent-telemetry 0755 || return 1

	procd_open_instance
	procd_set_param command "$PROG" telemetry
	procd_set_param user "$TELEMETRY_USER"
	procd_set_param group "$TELEMETRY_USER"
	# shellcheck disable=SC2046 # KEY=VALUE words without spaces (agent_env)
	procd_set_param env GOMEMLIMIT=40MiB $(agent_env)
	procd_set_param respawn 3600 10 0
	procd_set_param term_timeout 30
	procd_set_param no_new_privs 1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
