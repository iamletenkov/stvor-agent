# stvor-agent-telemetry: telemetry of this machine to the Stvor portal (Stvor spec
# "robot telemetry" §6, ADR-0034; agent spec §7). Unprivileged: user stvor-telemetry
# (sysusers.d/stvor-agent.conf), no capabilities, read-only system, writes only its
# state directory (buffer, token-rejected marker) and runtime directory (status).
# The token is written by stvor-agent.service (root) to /etc/stvor-agent-telemetry/token,
# file 0640 root:stvor-telemetry — not LoadCredential= (systemd >= 247): Jetson L4T R32
# is Ubuntu 18.04 with systemd 237. `systemd-analyze verify` on 237 knows every directive
# below except the ones marked (>= N): it logs «Unknown lvalue» and ignores them.
[Unit]
Description=Stvor agent: telemetry of this machine to the portal
Documentation=https://github.com/iamletenkov/stvor-agent
ConditionPathExists=/etc/stvor-agent-telemetry/token
After=network-online.target
Wants=network-online.target

[Service]
# Type=exec needs systemd >= 240.
Type=simple
ExecStart=/usr/bin/stvor-agent telemetry
Restart=always
RestartSec=10
# SIGTERM: the service writes its RAM buffer to disk and exits.
TimeoutStopSec=30
User=stvor-telemetry
Group=stvor-telemetry
# STVOR_AGENT_LOG_LEVEL (cream domain stvor-agent).
EnvironmentFile=-/etc/cream/stvor-agent/config
# Budget (controller ruling, Stvor plan Task 18 review): MemoryMax=64M and
# CPUQuota=10% below are hard caps — a runaway service is throttled or OOM-killed in
# its own cgroup, never the machine; GOMEMLIMIT=40MiB makes the Go runtime collect
# well before the cap. The spec budget (< 30 MB RSS, < 1 % CPU) is a target checked
# by measurement (Stvor plan Task 21), not a limit set here. packaging/unit_test.go pins these.
Environment=GOMEMLIMIT=40MiB
StateDirectory=stvor-agent-telemetry
StateDirectoryMode=0700
RuntimeDirectory=stvor-agent-telemetry
RuntimeDirectoryMode=0755
SyslogIdentifier=stvor-agent-telemetry
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/var/lib/stvor-agent-telemetry
ReadOnlyPaths=-/etc/stvor-agent-telemetry
# read-only, not yes (accepted in the Task 18 review): statfs(2) of a /home
# filesystem must see it, not the empty directory ProtectHome=yes mounts over it.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# (>= 244)
ProtectKernelLogs=yes
# (>= 242)
ProtectHostname=yes
# No ProtectClock= and no @clock filter: the clock collector reads adjtimex(2).
# AF_NETLINK: rtnetlink (CAN bus state) and nl80211 (Wi-Fi bitrate).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Hard caps of the budget (see GOMEMLIMIT above). On the legacy cgroup hierarchy
# (L4T R32) systemd 237 applies MemoryMax= as MemoryLimit= itself; MemoryLimit= is
# deprecated in newer systemd.
MemoryMax=64M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
