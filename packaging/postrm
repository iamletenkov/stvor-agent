#!/bin/sh
# postrm of stvor-agent (spec §9.1): purge removes the tokens and the state of
# the agent and of its telemetry service (buffer). The user stvor-telemetry
# stays (Debian keeps system users: files may still carry its uid). The Teleport labels it set stay: they belong to the teleport
# extension of cream (/etc/cream/teleport), as does /etc/cream/stvor-agent.
set -e

case "$1" in
purge)
	rm -rf /etc/stvor-agent /var/lib/stvor-agent \
		/etc/stvor-agent-telemetry /var/lib/stvor-agent-telemetry
	;;
esac

if [ "$1" = remove ] || [ "$1" = purge ]; then
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
	fi
fi

exit 0
