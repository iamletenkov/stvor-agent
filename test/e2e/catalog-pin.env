# Pin of the cream-extensions catalog snapshot for make e2e (plan Task 20).
# CE_COMMIT — where the snapshot comes from (git archive of extensions/debian/
# teleport and stvor-agent, flattened to extensions/<name>, own
# cream-catalog.yaml); CATALOG_SHA256 — sha256 of `cream catalog pack` of it
# with SOURCE_DATE_EPOCH=0: the pin of content, not of the commit (ruling 4).
# A new snapshot: set CE_COMMIT, run make e2e — the FATAL line prints the new
# sum — and put it here.
CE_COMMIT=cc789c478ec7e227952adc43e32a1e3d7793742d
CATALOG_SHA256=99785a87f48647af41d720bba86f34fafe2791f1a6385f3a58eaae490a4c5405

# Checks that fail because of known defects of this snapshot (ids of
# test/e2e/inside.sh, space-separated): they print "xfail" and do not fail the
# run; once a defect is fixed the check prints XPASS and fails until its id
# leaves this list.
E2E_XFAIL=""
